# Cloud text/image model credentials — copy to `.env.model_api` (gitignored).
# This file is the only place live MODEL_API_KEY should live locally.
# Settings load order: `.env` → `.env.model_api` (later wins).

MODEL_API_BASE=https://128api.cn/v1
MODEL_API_KEY=
MODEL_FAST_TEXT=gemini-3.6-flash
MODEL_REASONING_TEXT=gpt-5.5
MODEL_SEMANTIC_FALLBACK=gemini-3.1-pro
MODEL_IMAGE=gpt-image-2
MODEL_API_TIMEOUT_SEC=60
MODEL_API_MAX_RETRIES=2

# Optional legacy aliases (only if MODEL_API_* unset):
# GEMINI_API_BASE=https://128api.cn/v1
# GEMINI_API_KEY=
