#!/usr/bin/env expect
set timeout -1
set host [expr {[info exists env(FLOWSTUDIO_REMOTE_HOST)] ? $env(FLOWSTUDIO_REMOTE_HOST) : "connect.westd.seetacloud.com"}]
set port [expr {[info exists env(FLOWSTUDIO_REMOTE_SSH_PORT)] ? $env(FLOWSTUDIO_REMOTE_SSH_PORT) : "34333"}]
set user [expr {[info exists env(FLOWSTUDIO_REMOTE_USER)] ? $env(FLOWSTUDIO_REMOTE_USER) : "root"}]
spawn env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY ssh -F /dev/null -N -o ProxyCommand=none -o ProxyJump=none -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=no -L 18101:127.0.0.1:18100 -L 18081:127.0.0.1:18081 -p $port $user@$host
expect {
  -re "(?i).*password:.*" { send "$env(FLOWSTUDIO_REMOTE_PASSWORD)\r"; exp_continue }
  eof
}
