#!/usr/bin/env expect
set timeout -1

set host [expr {[info exists env(FLOWSTUDIO_REMOTE_HOST)] ? $env(FLOWSTUDIO_REMOTE_HOST) : "connect.westd.seetacloud.com"}]
set port [expr {[info exists env(FLOWSTUDIO_REMOTE_SSH_PORT)] ? $env(FLOWSTUDIO_REMOTE_SSH_PORT) : "34333"}]
set user [expr {[info exists env(FLOWSTUDIO_REMOTE_USER)] ? $env(FLOWSTUDIO_REMOTE_USER) : "root"}]
set local_backend_port [expr {[info exists env(FLOWSTUDIO_LOCAL_CLOUD_BACKEND_PORT)] ? $env(FLOWSTUDIO_LOCAL_CLOUD_BACKEND_PORT) : "18000"}]

spawn env -u http_proxy -u https_proxy -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY ssh -F /dev/null -N -o ProxyCommand=none -o ProxyJump=none -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=no -L $local_backend_port:127.0.0.1:18000 -p $port $user@$host
expect {
  -re "(?i).*password:.*" {
    if {![info exists env(FLOWSTUDIO_REMOTE_PASSWORD)]} {
      puts stderr "FLOWSTUDIO_REMOTE_PASSWORD is required for password auth."
      exit 1
    }
    send "$env(FLOWSTUDIO_REMOTE_PASSWORD)\r"
    exp_continue
  }
  eof
}
