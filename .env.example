REMOTE_CREATIVEFLOW_WORKER_URL=http://127.0.0.1:18100
REMOTE_CREATIVEFLOW_REAL_JOBS=true
REMOTE_CREATIVEFLOW_TRANSFER_VARIANT=minimal
REMOTE_CREATIVEFLOW_AUTO_HY3D=false
REMOTE_CREATIVEFLOW_HY3D_MAX_CANDIDATES=1

# Active external model runtime. MODEL_API_* is authoritative; existing
# GEMINI_API_* values remain a credential compatibility fallback.
MODEL_API_BASE=https://128api.cn/v1
MODEL_API_KEY=
MODEL_FAST_TEXT=gemini-3.6-flash
MODEL_REASONING_TEXT=gpt-5.5
MODEL_IMAGE=gpt-image-2
MODEL_API_TIMEOUT_SEC=60
MODEL_API_MAX_RETRIES=2

# Rollback adapters stay in source but are never active by default.
ENABLE_LEGACY_LOCAL_MODELS=false
ENABLE_3D_GENERATION=false

IUL_VLM_INTENT_URL=http://127.0.0.1:18084/v1/chat/completions
IUL_VLM_FALLBACK_URLS=http://127.0.0.1:18081/intent/interpret
IUL_VLM_MODEL=qwen3.5-27b
IUL_VLM_TIMEOUT_SEC=60
IUL_VLM_FALLBACK_TO_RULES=true
