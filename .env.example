REMOTE_CREATIVEFLOW_WORKER_URL=http://127.0.0.1:18100
REMOTE_CREATIVEFLOW_REAL_JOBS=true
REMOTE_CREATIVEFLOW_TRANSFER_VARIANT=minimal
REMOTE_CREATIVEFLOW_AUTO_HY3D=false
REMOTE_CREATIVEFLOW_HY3D_MAX_CANDIDATES=1

# Qwen planner retired — leave empty; rules fallback.
IUL_VLM_INTENT_URL=
IUL_VLM_FALLBACK_URLS=
IUL_VLM_MODEL=
IUL_VLM_TIMEOUT_SEC=60
IUL_VLM_FALLBACK_TO_RULES=true

# Cloud model keys live in `.env.model_api` (see `.env.model_api.example`).

ENABLE_LEGACY_LOCAL_MODELS=false
ENABLE_3D_GENERATION=true

# Single GPU host
FLOWSTUDIO_REMOTE_HOST=connect.westb.seetacloud.com
REMOTE_HOST=connect.westb.seetacloud.com
FLOWSTUDIO_REMOTE_SSH_PORT=36536
REMOTE_PORT=36536
FLOWSTUDIO_REMOTE_USER=root
REMOTE_USER=root
# FLOWSTUDIO_REMOTE_PASSWORD=
# REMOTE_PASSWORD=
